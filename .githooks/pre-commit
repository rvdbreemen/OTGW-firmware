#!/usr/bin/env bash
# adr-kit pre-commit hook (template; copied to project's .githooks/pre-commit by /adr-kit:install-hooks).
#
# Resolves the latest installed adr-kit version from the native Claude Code,
# Codex, or Copilot CLI plugin caches so upgrades don't require re-running
# install-hooks. Degrades gracefully when every cache is missing — the hook
# never blocks a commit because of tooling drift.
#
# As of v0.43.0 the per-commit LLM pass is ON BY DEFAULT (ADR-017) and runs on
# the host agent's own model -- no model is pinned. Each ADR with
# `"llm_judge": true` gets its own isolated call; they are never batched.
# The declarative regex/glob Enforcement pass is always-on and free.
# Nothing is spent until an author sets llm_judge:true on an ADR.
# Turn it off project-wide:  set judge.llm_enabled:false in docs/adr/.adr-kit.json
# Turn it off per commit:    ADR_KIT_NO_LLM=1 git commit ...
# Choose the backend:        python bin/adr-judge --set-backend {host,openrouter,ollama}
# On-demand LLM review:      /adr-kit:judge  (in a Claude Code session)
#
# As of v0.17.0 a flock concurrency guard serializes the heavy LLM passes so
# rapid or parallel commits do not fan out concurrent `claude -p` processes.
# Under lock contention the declarative pass still runs; LLM passes are suppressed.
#
# As of v0.14.1 the hook measures adr-judge wall-clock time and warns (non-blocking)
# when execution exceeds 5000ms. Uses `date +%s%3N`; falls back to perl on macOS.
#
# As of v0.16.0 the hook also runs `adr-suggest` (advisory, on by default as of
# ADR-035): it detects whether the staged diff introduces a NEW architectural
# decision not covered by an ADR and prints a one-line nudge. This NEVER blocks
# the commit.
# Disable per-commit:             ADR_KIT_SUGGEST_DISABLE=1 git commit ...
# Disable project-wide:           set suggest.enabled:false in docs/adr/.adr-kit.json
#
# Override ONE ADR's FAIL (audited): a reasoned override downgrades violations
# of a single named ADR to loud warnings for this commit only. The override is
# appended to the gitignored log docs/adr/.adr-kit-overrides.jsonl and the
# commit message SHOULD carry a matching 'ADR-Override: ADR-NNN <reason>'
# trailer (reconcile later with `adr-judge --audit-overrides`). An empty
# reason is refused. Violations of other ADRs still block.
#   ADR_KIT_OVERRIDE="ADR-003: hotfix for incident 42" git commit ...
#
# Disable LLM pass per commit:    ADR_KIT_NO_LLM=1 git commit ...
# Force LLM pass on per commit:   ADR_KIT_LLM=1 git commit ...
# Force suggest on per commit:    ADR_KIT_SUGGEST=1 git commit ...
# Disable ADR-suggestion nudge:   ADR_KIT_SUGGEST_DISABLE=1 git commit ...
# Disable hook entirely:          ADR_KIT_HOOK_DISABLE=1 git commit ...
# Remove permanently:             /adr-kit:install-hooks --uninstall  (in a Claude Code session)

set -e

# Wrapper version stamp (v0.27.0+). The engines below self-upgrade (they
# resolve the newest plugin cache version per commit), but THIS copied script
# freezes at install time. adr-guardian compares this stamp against the
# installed plugin version and nudges /adr-kit:upgrade when the wrapper lags.
# Maintained by scripts/bump-version.py; do not edit by hand.
ADR_KIT_WRAPPER_VERSION="0.47.0"

if [ "${ADR_KIT_HOOK_DISABLE:-0}" = "1" ]; then
  echo "[adr-kit] hook disabled for this commit (ADR_KIT_HOOK_DISABLE=1)" >&2
  exit 0
fi

# Verify Python 3 is available — adr-judge is a Python 3 script.
_PYTHON3=""
for _cmd in python3 python py; do
  if command -v "$_cmd" >/dev/null 2>&1; then
    _ver=$("$_cmd" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    _major=$(echo "$_ver" | cut -d. -f1)
    if [ "${_major:-0}" -ge 3 ] 2>/dev/null; then
      _PYTHON3="$_cmd"
      break
    fi
  fi
done

if [ -z "$_PYTHON3" ]; then
  echo "[adr-kit] ERROR: Python 3 not found. adr-judge requires Python 3.10+." >&2
  echo "[adr-kit] Install Python: https://www.python.org/downloads/" >&2
  echo "[adr-kit] On macOS: brew install python3" >&2
  echo "[adr-kit] On Windows: winget install Python.Python.3.12" >&2
  echo "[adr-kit] Skipping ADR check for this commit." >&2
  exit 0
fi

ADR_JUDGE=""
ADR_SUGGEST=""
ADR_GRILL_SIGNAL=""
_plugin_roots=()
shopt -s nullglob
_plugin_roots+=(
  "${HOME}/.claude/plugins/cache/rvdbreemen-adr-kit/adr-kit"/*
  "${CODEX_HOME:-${HOME}/.codex}/plugins/cache/rvdbreemen-adr-kit-codex/adr-kit"/*
)
shopt -u nullglob
_copilot_root="${COPILOT_HOME:-${HOME}/.copilot}/installed-plugins/rvdbreemen-adr-kit-copilot/adr-kit"
if [ -d "$_copilot_root" ]; then
  _plugin_roots+=("$_copilot_root")
fi

# A checkout of ADR Kit itself is a candidate too, so the repository is judged
# by the engine it currently ships rather than by an older installed release.
# It competes on manifest version like any other root, so an installed plugin
# still wins when the checkout is behind.
_self_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$_self_root" ] && [ -f "$_self_root/bin/adr-judge" ] &&
   [ -f "$_self_root/.claude-plugin/plugin.json" ]; then
  _plugin_roots+=("$_self_root")
fi

# Select the highest manifest version, independently of which client owns the
# cache. Python is already required by the engines and keeps JSON parsing
# robust without jq or shell regexes.
_best_version="0.0.0"
for _plugin_root in "${_plugin_roots[@]}"; do
  [ -f "$_plugin_root/bin/adr-judge" ] || continue
  _manifest=""
  for _candidate_manifest in \
    "$_plugin_root/.claude-plugin/plugin.json" \
    "$_plugin_root/.codex-plugin/plugin.json" \
    "$_plugin_root/plugin.json"; do
    if [ -f "$_candidate_manifest" ]; then
      _manifest="$_candidate_manifest"
      break
    fi
  done
  [ -n "$_manifest" ] || continue
  _candidate_version=$(
    "$_PYTHON3" -c \
      'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("version", "0.0.0"))' \
      "$_manifest" 2>/dev/null
  ) || _candidate_version="0.0.0"
  _newest=$(printf '%s\n%s\n' "$_best_version" "$_candidate_version" | sort -V | tail -1)
  if [ "$_newest" = "$_candidate_version" ]; then
    _best_version="$_candidate_version"
    ADR_JUDGE="$_plugin_root/bin/adr-judge"
    if [ -f "$_plugin_root/bin/adr-suggest" ]; then
      ADR_SUGGEST="$_plugin_root/bin/adr-suggest"
    else
      ADR_SUGGEST=""
    fi
    if [ -f "$_plugin_root/bin/adr-grill-signal" ]; then
      ADR_GRILL_SIGNAL="$_plugin_root/bin/adr-grill-signal"
    else
      ADR_GRILL_SIGNAL=""
    fi
  fi
done

if [ -z "$ADR_JUDGE" ] || [ ! -f "$ADR_JUDGE" ]; then
  echo "[adr-kit] adr-judge binary not found in plugin cache; skipping pre-commit ADR check." >&2
  echo "[adr-kit] Re-install ADR Kit for Claude Code, Codex, or Copilot CLI." >&2
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
# Skip when there are no staged changes — cheaper than buffering the full diff just to test emptiness.
if [ -z "$(git diff --cached --name-only)" ]; then
  exit 0
fi

# Concurrency guard: serialize the heavy LLM passes so rapid or parallel commits
# don't fan out concurrent `claude -p` processes. We take a non-blocking advisory
# lock; if another adr-judge already holds it, we keep the cheap declarative pass
# but suppress the LLM passes for THIS commit (via ADR_KIT_NO_LLM). The lockfile
# lives under .git/ so it's never committed. flock is absent on bare Windows
# cmd.exe; there we degrade to no-lock (same behaviour as before).
_NO_LLM_OVERRIDE=""
if command -v flock >/dev/null 2>&1; then
  exec 9>"$ROOT/.git/adr-kit-judge.lock" 2>/dev/null || true
  if ! flock -n 9 2>/dev/null; then
    echo "[adr-kit] another ADR judge is running; declarative-only for this commit (LLM gate skipped)." >&2
    _NO_LLM_OVERRIDE=1
  fi
fi

# Portable millisecond timestamp: `date +%s%3N` works on Linux/Git-Bash/WSL.
# On macOS the GNU %3N extension is absent, so we fall back to perl.
_ms_now() {
  local t
  t=$(date +%s%3N 2>/dev/null)
  # Reject empty or non-numeric results (macOS BSD date returns literal "%3N").
  case "$t" in
    ''|*[!0-9]*) t=$(perl -e 'print int(time()*1000)') ;;
  esac
  printf '%s' "$t"
}

# Performance budget: judge.pre_commit_timeout_ms.
#
# The budget is a project decision and lives in the same docs/adr/.adr-kit.json
# the judge is pointed at below. This wrapper is a repo-tracked file a hand can
# edit, so the value is validated rather than trusted -- the shape
# hooks/adr_pr_guard.py applies to runner_timeout_sec.
#
#   absent        -> 5000 ms, the schema default
#   0             -> warning off, matching bin/adr-judge's own reading of 0
#   1..3600000    -> used as given
#   anything else -> refused, named on stderr, 5000 ms
#
# The ceiling is an hour rather than something tighter because
# judge.llm_timeout_seconds defaults to 120 s and bounds ONE call, with one call
# per llm_judge:true ADR. A ten-ADR project has a legitimate twenty-minute
# commit; a lower ceiling would refuse a correct configuration.
_ADR_KIT_MAX_BUDGET_MS=3600000
_BUDGET_READ=$(
  "$_PYTHON3" -c     'import json,sys
state, budget, warn = "absent", "5000", "1"
try:
    judge = json.load(open(sys.argv[1], encoding="utf-8"))["judge"]
except Exception:
    judge = {}
if isinstance(judge, dict):
    if judge.get("warn_on_exceed", True) is False:
        warn = "0"
    if "pre_commit_timeout_ms" in judge:
        value = judge["pre_commit_timeout_ms"]
        if (isinstance(value, bool) or not isinstance(value, int)
                or not 0 <= value <= int(sys.argv[2])):
            state = "invalid"
        else:
            state, budget = "ok", str(value)
print(state, budget, warn)'     "$ROOT/docs/adr/.adr-kit.json" "$_ADR_KIT_MAX_BUDGET_MS" 2>/dev/null
) || _BUDGET_READ=""
_BUDGET_STATE=$(printf '%s' "$_BUDGET_READ" | cut -d' ' -f1)
_BUDGET_MS=$(printf '%s' "$_BUDGET_READ" | cut -d' ' -f2)
_WARN_ON_EXCEED=$(printf '%s' "$_BUDGET_READ" | cut -d' ' -f3)
case "$_BUDGET_STATE" in
  ok|absent) ;;
  invalid)
    echo "[adr-kit] WARN: judge.pre_commit_timeout_ms is not an integer from 0 to ${_ADR_KIT_MAX_BUDGET_MS}; using ${_BUDGET_MS}ms." >&2
    ;;
  *) _BUDGET_MS=5000; _WARN_ON_EXCEED=1 ;;
esac

# Run the judge.
#   - declarative pass:  always-on; fast, regex-only, exits non-zero on violation
#   - LLM pass (default on): one isolated call per llm_judge:true ADR, on the
#                        backend judge.backend selects (host/openrouter/ollama);
#                        disabled by ADR_KIT_NO_LLM=1 or judge.llm_enabled:false;
#                        suppressed under lock contention (_NO_LLM_OVERRIDE)
# Exit codes:
#   0  no violations (advisory entries are non-blocking)
#   1  at least one violation (declarative or LLM)
#   2  config or runtime error
_LLM_FLAG=""
[ "${ADR_KIT_LLM:-0}" = "1" ] && _LLM_FLAG="--llm"
_T0=$(_ms_now)
# `set -e` is lifted around the judge call. Without this, a non-zero exit from
# the command substitution would abort the hook immediately, so every line
# below -- including the violation report -- would never run and the commit
# would be blocked with no explanation at all.
set +e
ADR_OUT=$(git diff --cached --unified=0 | ADR_KIT_NO_LLM="${_NO_LLM_OVERRIDE:-0}" "$ADR_JUDGE" --diff - --adr-dir "$ROOT/docs/adr/" --repo-root "$ROOT" --snapshot staged $_LLM_FLAG 2>&1)
ADR_EXIT=$?
set -e
_T1=$(_ms_now)
# Suppress per-ADR llm_judge advisory lines: they repeat once per ADR with llm_judge:true
# and become very noisy on projects with many ADRs. Violations and the summary line
# (e.g. "[adr-judge] OK 0 violations, 57 advisory") are preserved.
printf '%s\n' "$ADR_OUT" | grep -avE "^  ADVISORY |^[[:space:]]+ADR has llm_judge:true" >&2 || true
# Performance warning (non-blocking): alert when adr-judge exceeds the budget
# judge.pre_commit_timeout_ms declares. 0 turns it off; so does warn_on_exceed:false.
_ELAPSED=$(( _T1 - _T0 ))
if [ "$_WARN_ON_EXCEED" = "1" ] && [ "${_BUDGET_MS:-0}" -gt 0 ] 2>/dev/null && [ "$_ELAPSED" -gt "$_BUDGET_MS" ] 2>/dev/null; then
  echo "[adr-kit] WARN: pre-commit hook took ${_ELAPSED}ms (threshold: ${_BUDGET_MS}ms from judge.pre_commit_timeout_ms). Consider ADR_KIT_NO_LLM=1 for faster commits." >&2
fi
# Exit 2 means the judge could not run at all (bad config, engine mismatch).
# Name that explicitly: a blocked commit with only tool output is hard to read.
if [ "$ADR_EXIT" -eq 2 ]; then
  echo "[adr-kit] adr-judge could not run (exit 2: config or runtime error)." >&2
  echo "[adr-kit] Engine: $ADR_JUDGE (manifest version $_best_version)." >&2
  echo "[adr-kit] Commit with ADR_KIT_HOOK_DISABLE=1 to bypass this check." >&2
fi
[ "$ADR_EXIT" -ne 0 ] && exit "$ADR_EXIT"

# --- Generated-index freshness (advisory) --------------------------------------
# The lifecycle CLI regenerates README.md, ADR-INDEX.md and ADR-INDEX.json inside
# its own transaction, so anything written through `bin/adr` keeps them true. An
# ADR edited by hand -- or written straight to disk by a coding agent -- does not,
# and a stale index is exactly the artefact every other tool reads first.
#
# Advisory, not blocking, and the reason is not politeness: `adr-index --check`
# reads the WORKTREE, while this commit is the staged snapshot. On a partial
# commit those differ, so a block here could refuse a correct commit over a file
# the author deliberately left unstaged. CI checks out the commit itself, where
# worktree and commit are the same thing, and blocks there (adr-index-check.yml).
if [ -n "$ADR_JUDGE" ] && git diff --cached --name-only | grep -qE '(^|/)docs/adr/ADR-[0-9]+.*\.md$'; then
  _ADR_INDEX="$(dirname "$ADR_JUDGE")/adr-index"
  if [ -f "$_ADR_INDEX" ]; then
    if ! "$_PYTHON3" "$_ADR_INDEX" "$ROOT/docs/adr" --check >/dev/null 2>&1; then
      echo "[adr-kit] WARN: the generated ADR indexes are stale in your worktree." >&2
      echo "[adr-kit]       Run: $_PYTHON3 $_ADR_INDEX $ROOT/docs/adr   then stage the result." >&2
      echo "[adr-kit]       CI blocks on this; the hook only warns (it reads the worktree, not the index)." >&2
    fi
  fi
fi

# Bounded, index-only ADR grilling advisories. This is a single fail-open
# subprocess: no readiness sweep, per-ADR subprocess loop, model, network, or
# provider credential. adr-judge above remains the only local blocking path.
if [ -n "$ADR_GRILL_SIGNAL" ] && [ -f "$ADR_GRILL_SIGNAL" ]; then
  GRILL_OUT=$(
    "$_PYTHON3" "$ADR_GRILL_SIGNAL" \
      --staged --repo-root "$ROOT" --shell posix --format human 2>/dev/null || true
  )
  printf '%s\n' "$GRILL_OUT" | grep -aE "^\[adr-grill\] (STRONG|ADVISORY) " >&2 || true
fi

# --- Advisory ADR-suggestion pass (adr-suggest, v0.16.0+; on by default) ------
# Distinct from adr-judge above: adr-judge ENFORCES existing ADRs and can block
# the commit. adr-suggest only DETECTS whether the diff introduces a NEW
# architectural decision not yet covered by any ADR, and prints a one-line
# nudge. It NEVER blocks — its exit status is swallowed with `|| true`.
#
# On by default since ADR-035, on the same terms ADR-017 set for the judge.
# Switch it off with ADR_KIT_SUGGEST_DISABLE=1 (per-commit) or
# suggest.enabled:false in .adr-kit.json (per-project); adr-suggest honours both
# itself, so the switch holds on every path that runs it, not only this hook.
# It also self-skips when no backend resolves or the diff carries no code.
# Suppressed under lock contention.
if [ "${ADR_KIT_SUGGEST_DISABLE:-0}" != "1" ] && [ "${_NO_LLM_OVERRIDE:-0}" != "1" ] && [ -n "$ADR_SUGGEST" ] && [ -x "$ADR_SUGGEST" ]; then
  # Derive the suggest bound from the same budget the judge warning uses, so the
  # advisory pass cannot outlast what this hook declares it may cost. Floor of
  # 10 s: a budget of 0 disables the WARN, it does not mean "no time at all".
  _SUGGEST_TIMEOUT_S=$(( ${_BUDGET_MS:-5000} / 1000 ))
  [ "$_SUGGEST_TIMEOUT_S" -lt 10 ] && _SUGGEST_TIMEOUT_S=10
  SUGGEST_OUT=$(git diff --cached --unified=0 | "$ADR_SUGGEST" --diff - --adr-dir "$ROOT/docs/adr/" --llm-timeout "$_SUGGEST_TIMEOUT_S" 2>&1 || true)
  # Only surface the actual suggestion lines; the "(skipped: ...)" / "LLM
  # unavailable" notes are noise on commits that don't introduce a decision.
  printf '%s\n' "$SUGGEST_OUT" | grep -aE "^\[adr-suggest\] (This change|  )" >&2 || true
fi

exit 0
